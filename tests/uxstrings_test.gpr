with "lib_uxstrings.gpr";

project UXStrings_Test is

   for Languages use ("Ada");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   
   TEST := ();
   case Lib_UxStrings.UXStrings_Variant is
      when "UXS1" =>
         TEST := ("test_uxstrings1.adb", "test_uxstrings_text_io.adb", "test_uxstrings2.adb", "test_uxstrings_text_io2.adb");
      when "UXS2" =>
         TEST := ("test_uxstrings1.adb", "test_uxstrings_text_io.adb", "test_uxstrings2.adb", "test_uxstrings_text_io2.adb");
      when "UXS3" =>
         TEST := ("test_uxstrings3.adb", "test_uxstrings_text_io.adb", "test_uxstrings2.adb", "test_uxstrings_text_io2.adb");
      when "UXS4" =>
         TEST := ("test_uxstrings4a.adb", "test_uxstrings_text_io.adb", "test_uxstrings4b.adb", "test_uxstrings_text_io2.adb");
      when "UXS5" =>
         TEST := ("test_uxstrings4a.adb", "test_uxstrings_text_io.adb", "test_uxstrings4b.adb", "test_uxstrings_text_io2.adb");
   end case;

   for Main use TEST;
 
   package Compiler renames Lib_UxStrings.Compiler;
   package Binder renames Lib_UxStrings.Binder;
   package Pretty_Printer renames Lib_UxStrings.Pretty_Printer;

end UXStrings_Test;
